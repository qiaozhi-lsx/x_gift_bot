XGIFT_ORIGIN=https://xp.example.com
XGIFT_LISTEN=127.0.0.1:8787
XGIFT_DATA_DIR=/var/lib/xgift
XGIFT_PASSWORD_FILE=/etc/xgift/vault-password
XGIFT_ADMIN_PASSWORD_FILE=/etc/xgift/admin-password
# Admin Basic-auth username (required, >=6 chars, must not be "admin") and the
# secret path prefix the whole admin surface is served under ("" keeps legacy
# /admin + /api/admin/* paths; set e.g. XGIFT_ADMIN_PATH=/k7m2x9wq3zf to move
# the admin UI, its assets and its API off guessable paths).
XGIFT_ADMIN_USER=
XGIFT_ADMIN_PATH=
XGIFT_PAYMENTS_ENABLED=false

# Configure both values to enable server-verified Turnstile on public submissions.
# Keep the secret in a private file, never in source control.
XGIFT_TURNSTILE_SITE_KEY=
XGIFT_TURNSTILE_SECRET_FILE=
